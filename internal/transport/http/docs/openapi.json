{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "description": "API модуля трекера задач с поддержкой периодичности",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "tags": [{ "name": "tasks", "description": "Управление задачами" }],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["tasks"],
        "summary": "Список всех задач",
        "operationId": "listTasks",
        "responses": {
          "200": {
            "description": "Список задач",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } } } }
          }
        }
      },
      "post": {
        "tags": ["tasks"],
        "summary": "Создать задачу",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskMutation" },
              "examples": {
                "one_time": {
                  "summary": "Разовая задача",
                  "value": { "title": "Сделать обход", "description": "Обход пациентов", "status": "new" }
                },
                "daily": {
                  "summary": "Каждые 2 дня",
                  "value": { "title": "Обзвон пациентов", "status": "new", "recurrence": { "type": "daily", "interval": 2, "start_date": "2025-01-01T00:00:00Z" } }
                },
                "monthly": {
                  "summary": "1-го и 15-го числа",
                  "value": { "title": "Формирование отчётности", "status": "new", "recurrence": { "type": "monthly", "month_days": [1, 15], "start_date": "2025-01-01T00:00:00Z" } }
                },
                "even_days": {
                  "summary": "По чётным числам",
                  "value": { "title": "Инвентаризация", "status": "new", "recurrence": { "type": "even_days", "start_date": "2025-01-01T00:00:00Z" } }
                },
                "odd_days": {
                  "summary": "По нечётным числам",
                  "value": { "title": "Ежедневный обзвон", "status": "new", "recurrence": { "type": "odd_days", "start_date": "2025-01-01T00:00:00Z" } }
                },
                "specific_dates": {
                  "summary": "На конкретные даты",
                  "value": { "title": "Операция", "status": "new", "recurrence": { "type": "specific_dates", "dates": ["2025-03-10T00:00:00Z", "2025-04-22T00:00:00Z"] } }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Задача создана", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": {
        "tags": ["tasks"], "summary": "Получить задачу по ID", "operationId": "getTask",
        "responses": {
          "200": { "description": "Задача", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["tasks"], "summary": "Обновить задачу", "operationId": "updateTask",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskMutation" } } } },
        "responses": {
          "200": { "description": "Обновлённая задача", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["tasks"], "summary": "Удалить задачу", "operationId": "deleteTask",
        "responses": { "204": { "description": "Удалено" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/tasks/{id}/occurrences": {
      "get": {
        "tags": ["tasks"],
        "summary": "Ближайшие даты повторений задачи",
        "description": "Возвращает до n дат (начиная с сегодня), когда задача активна по расписанию.",
        "operationId": "getNextOccurrences",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "n", "in": "query", "required": false, "schema": { "type": "integer", "default": 10, "minimum": 1, "maximum": 100 }, "description": "Кол-во дат" }
        ],
        "responses": {
          "200": {
            "description": "Список дат",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Occurrences" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Recurrence": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["daily", "monthly", "specific_dates", "even_days", "odd_days"] },
          "interval": { "type": "integer", "minimum": 1, "description": "Только для daily: каждые N дней" },
          "month_days": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 30 }, "description": "Только для monthly" },
          "dates": { "type": "array", "items": { "type": "string", "format": "date-time" }, "description": "Только для specific_dates" },
          "start_date": { "type": "string", "format": "date-time", "description": "Начало расписания (по умолчанию сегодня)" },
          "end_date": { "type": "string", "format": "date-time", "description": "Конец расписания (null = бессрочно)" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"] },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TaskMutation": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "default": "new" },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" }
        }
      },
      "Occurrences": {
        "type": "object",
        "properties": { "occurrences": { "type": "array", "items": { "type": "string", "format": "date-time" } } }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": { "description": "Некорректный запрос", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Задача не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
